{
  "name": "sidestory",
  "displayName": "Sidestory",
  "description": "Rich explainers beside your code: diagrams, live React widgets and prose linked both ways to the code. Written by you or any AI agent.",
  "version": "0.1.0",
  "publisher": "paperkite",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mozru/sidestory.git"
  },
  "bugs": {
    "url": "https://github.com/mozru/sidestory/issues"
  },
  "homepage": "https://github.com/mozru/sidestory#readme",
  "qna": "marketplace",
  "preview": true,
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1f2937",
    "theme": "dark"
  },
  "keywords": [
    "explain",
    "explainer",
    "walkthrough",
    "code tour",
    "tour",
    "documentation",
    "docs",
    "onboarding",
    "code review",
    "literate programming",
    "diagram",
    "block diagram",
    "visualization",
    "interactive",
    "widgets",
    "react",
    "html",
    "rtl",
    "verilog",
    "systemverilog",
    "hardware",
    "fpga",
    "asic",
    "ai",
    "agent",
    "claude",
    "codex"
  ],
  "engines": {
    "vscode": "^1.95.0",
    "node": ">=22.18"
  },
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Explainers render safely in Restricted Mode, but a panel left open isn't restored automatically: open it again yourself."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Explainers are resolved against files on disk."
    }
  },
  "categories": [
    "Visualization",
    "Education",
    "Other"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "workspaceContains:**/.explain/*/manifest.json",
    "onWebviewPanel:sidestory.explainer"
  ],
  "contributes": {
    "commands": [
      {
        "command": "sidestory.open",
        "title": "Open Explainer",
        "category": "Sidestory"
      },
      {
        "command": "sidestory.nextStep",
        "title": "Next Step",
        "category": "Sidestory"
      },
      {
        "command": "sidestory.prevStep",
        "title": "Previous Step",
        "category": "Sidestory"
      },
      {
        "command": "sidestory.pin",
        "title": "Pin Anchors to the Current Code",
        "category": "Sidestory"
      },
      {
        "command": "sidestory.reanchor",
        "title": "Re-anchor Section to Selection",
        "category": "Sidestory"
      },
      {
        "command": "sidestory.revokeWidgetConsent",
        "title": "Revoke Widget Consent",
        "category": "Sidestory"
      },
      {
        "command": "sidestory.enableWidgets",
        "title": "Enable Widgets",
        "category": "Sidestory"
      },
      {
        "command": "sidestory.checkWidgets",
        "title": "Check Widgets",
        "category": "Sidestory"
      },
      {
        "command": "sidestory.copyWidgetCheckCommand",
        "title": "Copy Widget Check Command",
        "category": "Sidestory"
      },
      {
        "command": "sidestory.addWidgetTypes",
        "title": "Add Widget Types",
        "category": "Sidestory"
      }
    ],
    "keybindings": [
      {
        "command": "sidestory.nextStep",
        "key": "alt+]",
        "when": "sidestory.active && !inlineSuggestionVisible && !suggestWidgetVisible"
      },
      {
        "command": "sidestory.prevStep",
        "key": "alt+[",
        "when": "sidestory.active && !inlineSuggestionVisible && !suggestWidgetVisible"
      }
    ],
    "configuration": {
      "title": "Sidestory",
      "properties": {
        "sidestory.dimUnfocused": {
          "type": "boolean",
          "default": true,
          "description": "Dim code outside the active step when you move through the explainer."
        },
        "sidestory.widgets.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "markdownDescription": "Run interactive widgets in explainers. Widgets are code from the repository: they never run in Restricted Mode, and each workspace asks before running them. A repository's own settings can't turn this on."
        }
      }
    },
    "colors": [
      {
        "id": "sidestory.focusBackground",
        "description": "Background of the lines the active explainer step is about.",
        "defaults": {
          "dark": "editor.rangeHighlightBackground",
          "light": "editor.rangeHighlightBackground",
          "highContrast": "#00000000",
          "highContrastLight": "#00000000"
        }
      },
      {
        "id": "sidestory.focusBorder",
        "description": "Left bar on the active step's lines when the step has no accent color.",
        "defaults": {
          "dark": "focusBorder",
          "light": "focusBorder",
          "highContrast": "contrastActiveBorder",
          "highContrastLight": "contrastActiveBorder"
        }
      },
      {
        "id": "sidestory.highlightBackground",
        "description": "Background of identifiers the active step highlights.",
        "defaults": {
          "dark": "editor.wordHighlightStrongBackground",
          "light": "editor.wordHighlightStrongBackground",
          "highContrast": "#00000000",
          "highContrastLight": "#00000000"
        }
      },
      {
        "id": "sidestory.highlightBorder",
        "description": "Border of identifiers the active step highlights.",
        "defaults": {
          "dark": "#00000000",
          "light": "#00000000",
          "highContrast": "contrastActiveBorder",
          "highContrastLight": "contrastActiveBorder"
        }
      },
      {
        "id": "sidestory.widgetHighlightBackground",
        "description": "Background of the lines a widget highlights in the editor.",
        "defaults": {
          "dark": "editor.wordHighlightBackground",
          "light": "editor.wordHighlightBackground",
          "highContrast": "#00000000",
          "highContrastLight": "#00000000"
        }
      },
      {
        "id": "sidestory.widgetHighlightBorder",
        "description": "Border of the lines a widget highlights in the editor (high contrast themes, where backgrounds are transparent).",
        "defaults": {
          "dark": "editor.wordHighlightBorder",
          "light": "editor.wordHighlightBorder",
          "highContrast": "contrastActiveBorder",
          "highContrastLight": "contrastActiveBorder"
        }
      },
      {
        "id": "sidestory.staleForeground",
        "description": "Explainer sections whose code changed a lot.",
        "defaults": {
          "dark": "editorWarning.foreground",
          "light": "#8a6100",
          "highContrast": "editorWarning.foreground",
          "highContrastLight": "editorWarning.foreground"
        }
      },
      {
        "id": "sidestory.lostForeground",
        "description": "Explainer sections whose code can't be found.",
        "defaults": {
          "dark": "editorError.foreground",
          "light": "editorError.foreground",
          "highContrast": "editorError.foreground",
          "highContrastLight": "editorError.foreground"
        }
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "sidestory.nextStep",
          "when": "sidestory.active"
        },
        {
          "command": "sidestory.prevStep",
          "when": "sidestory.active"
        }
      ],
      "editor/context": [
        {
          "command": "sidestory.reanchor",
          "when": "sidestory.active && editorHasSelection",
          "group": "navigation@90"
        }
      ],
      "explorer/context": [
        {
          "command": "sidestory.open",
          "when": "explorerResourceIsFolder && resourceDirname =~ /\\.explain$/",
          "group": "navigation@90"
        }
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p src/core/tsconfig.json --noEmit && tsc -p src/widget-runtime/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:webview": "playwright test -c test/webview/playwright.config.ts",
    "test:widgets": "playwright test -c test/widgets/playwright.config.ts",
    "test:e2e": "playwright test -c test/e2e/playwright.config.ts",
    "pin": "node scripts/pin.ts",
    "release": "node scripts/release.mjs",
    "sync-skill": "node scripts/sync-skill.mjs",
    "package": "node scripts/build.mjs --production && vsce package --no-dependencies -o dist/sidestory.vsix",
    "check": "npm run typecheck && npm test && npm run build",
    "test:desktop": "npm run build && node test/desktop/run.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/browser": "4.3.3",
    "@types/mocha": "10.0.10",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/vscode": "1.95.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "^4.0.0",
    "clsx": "2.1.1",
    "d3": "7.9.0",
    "esbuild": "^0.28.2",
    "lodash": "4.18.1",
    "lucide-react": "1.52.0",
    "mocha": "11.7.5",
    "motion": "14.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-is": "19.3.0",
    "recharts": "3.10.1",
    "tailwind-merge": "3.7.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@shikijs/core": "4.5.0",
    "@shikijs/engine-javascript": "4.5.0",
    "@shikijs/langs": "4.5.0",
    "@shikijs/themes": "4.5.0",
    "@vscode/codicons": "0.0.46-24",
    "acorn": "8.19.0",
    "acorn-walk": "8.3.5",
    "idiomorph": "0.8.0",
    "jsonc-parser": "3.3.1",
    "sucrase": "3.35.1",
    "zod": "4.6.7"
  },
  "type": "module"
}
