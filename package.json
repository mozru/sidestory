{
  "name": "code-explainer",
  "displayName": "Code Explainer",
  "description": "Rich HTML explainers beside your code, linked both ways, updated live.",
  "version": "0.1.0",
  "publisher": "code-explainer",
  "license": "MIT",
  "preview": true,
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1f2937",
    "theme": "dark"
  },
  "keywords": [
    "explainer",
    "documentation",
    "walkthrough",
    "code tour",
    "literate programming",
    "verilog",
    "systemverilog",
    "review"
  ],
  "engines": {
    "vscode": "^1.95.0",
    "node": ">=22.18"
  },
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Explainers render safely in Restricted Mode, but a panel left open isn't restored automatically: open it again yourself."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Explainers are resolved against files on disk."
    }
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "workspaceContains:**/.explain/*/manifest.json",
    "onWebviewPanel:codeExplainer.explainer"
  ],
  "contributes": {
    "commands": [
      {
        "command": "codeExplainer.open",
        "title": "Open Explainer",
        "category": "Code Explainer"
      },
      {
        "command": "codeExplainer.nextStep",
        "title": "Next Step",
        "category": "Code Explainer"
      },
      {
        "command": "codeExplainer.prevStep",
        "title": "Previous Step",
        "category": "Code Explainer"
      },
      {
        "command": "codeExplainer.pin",
        "title": "Pin Anchors to the Current Code",
        "category": "Code Explainer"
      },
      {
        "command": "codeExplainer.reanchor",
        "title": "Re-anchor Section to Selection",
        "category": "Code Explainer"
      }
    ],
    "keybindings": [
      {
        "command": "codeExplainer.nextStep",
        "key": "alt+]",
        "when": "codeExplainer.active && !inlineSuggestionVisible && !suggestWidgetVisible"
      },
      {
        "command": "codeExplainer.prevStep",
        "key": "alt+[",
        "when": "codeExplainer.active && !inlineSuggestionVisible && !suggestWidgetVisible"
      }
    ],
    "configuration": {
      "title": "Code Explainer",
      "properties": {
        "codeExplainer.dimUnfocused": {
          "type": "boolean",
          "default": true,
          "description": "Dim code outside the active step when you move through the explainer."
        }
      }
    },
    "colors": [
      {
        "id": "codeExplainer.focusBackground",
        "description": "Background of the lines the active explainer step is about.",
        "defaults": {
          "dark": "editor.rangeHighlightBackground",
          "light": "editor.rangeHighlightBackground",
          "highContrast": "#00000000",
          "highContrastLight": "#00000000"
        }
      },
      {
        "id": "codeExplainer.focusBorder",
        "description": "Left bar on the active step's lines when the step has no accent color.",
        "defaults": {
          "dark": "focusBorder",
          "light": "focusBorder",
          "highContrast": "contrastActiveBorder",
          "highContrastLight": "contrastActiveBorder"
        }
      },
      {
        "id": "codeExplainer.highlightBackground",
        "description": "Background of identifiers the active step highlights.",
        "defaults": {
          "dark": "editor.wordHighlightStrongBackground",
          "light": "editor.wordHighlightStrongBackground",
          "highContrast": "#00000000",
          "highContrastLight": "#00000000"
        }
      },
      {
        "id": "codeExplainer.highlightBorder",
        "description": "Border of identifiers the active step highlights.",
        "defaults": {
          "dark": "#00000000",
          "light": "#00000000",
          "highContrast": "contrastActiveBorder",
          "highContrastLight": "contrastActiveBorder"
        }
      },
      {
        "id": "codeExplainer.staleForeground",
        "description": "Explainer sections whose code changed a lot.",
        "defaults": {
          "dark": "editorWarning.foreground",
          "light": "#8a6100",
          "highContrast": "editorWarning.foreground",
          "highContrastLight": "editorWarning.foreground"
        }
      },
      {
        "id": "codeExplainer.lostForeground",
        "description": "Explainer sections whose code can't be found.",
        "defaults": {
          "dark": "editorError.foreground",
          "light": "editorError.foreground",
          "highContrast": "editorError.foreground",
          "highContrastLight": "editorError.foreground"
        }
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "codeExplainer.nextStep",
          "when": "codeExplainer.active"
        },
        {
          "command": "codeExplainer.prevStep",
          "when": "codeExplainer.active"
        }
      ],
      "editor/context": [
        {
          "command": "codeExplainer.reanchor",
          "when": "codeExplainer.active && editorHasSelection",
          "group": "navigation@90"
        }
      ],
      "explorer/context": [
        {
          "command": "codeExplainer.open",
          "when": "explorerResourceIsFolder && resourceDirname =~ /\\.explain$/",
          "group": "navigation@90"
        }
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p src/core/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:webview": "playwright test -c test/webview/playwright.config.ts",
    "test:e2e": "playwright test -c test/e2e/playwright.config.ts",
    "pin": "node scripts/pin.ts",
    "package": "node scripts/build.mjs --production && vsce package --no-dependencies --allow-missing-repository -o dist/code-explainer.vsix",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/browser": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/vscode": "1.95.0",
    "@vscode/vsce": "^4.0.0",
    "clsx": "2.1.1",
    "d3": "7.9.0",
    "esbuild": "^0.28.2",
    "lodash": "4.18.1",
    "lucide": "1.61.0",
    "lucide-react": "1.61.0",
    "motion": "14.6.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-is": "19.3.1",
    "recharts": "3.10.1",
    "tailwind-merge": "3.7.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@vscode/codicons": "0.0.46-24",
    "acorn": "8.19.0",
    "acorn-walk": "8.3.5",
    "idiomorph": "0.8.0",
    "jsonc-parser": "3.3.1",
    "sucrase": "3.35.1",
    "zod": "4.6.7"
  },
  "type": "module"
}
