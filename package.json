{
  "name": "sidestory",
  "displayName": "Sidestory",
  "description": "Rich sidestories beside your code: diagrams, live React widgets and prose linked both ways to the code. Written by you or any AI agent.",
  "version": "0.2.0",
  "publisher": "paperkite",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mozru/sidestory.git"
  },
  "bugs": {
    "url": "https://github.com/mozru/sidestory/issues"
  },
  "homepage": "https://github.com/mozru/sidestory#readme",
  "qna": "marketplace",
  "preview": true,
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1f2937",
    "theme": "dark"
  },
  "keywords": [
    "explain",
    "explainer",
    "walkthrough",
    "code tour",
    "tour",
    "documentation",
    "docs",
    "onboarding",
    "code review",
    "literate programming",
    "diagram",
    "block diagram",
    "visualization",
    "interactive",
    "widgets",
    "react",
    "html",
    "rtl",
    "verilog",
    "systemverilog",
    "hardware",
    "fpga",
    "asic",
    "ai",
    "agent",
    "claude",
    "codex"
  ],
  "engines": {
    "vscode": "^1.95.0",
    "node": ">=22.18"
  },
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Sidestories render safely in Restricted Mode, but a panel left open isn't restored automatically: open it again yourself."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Sidestories are resolved against files on disk."
    }
  },
  "categories": [
    "Visualization",
    "Education",
    "Other"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "workspaceContains:**/.sidestory/*/manifest.json",
    "onWebviewPanel:sidestory.explainer",
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "sidestory.open",
        "title": "Open Sidestory…",
        "category": "Sidestory"
      },
      {
        "command": "sidestory.nextStep",
        "title": "Next Step",
        "category": "Sidestory"
      },
      {
        "command": "sidestory.prevStep",
        "title": "Previous Step",
        "category": "Sidestory"
      },
      {
        "command": "sidestory.pin",
        "title": "Pin Anchors to the Current Code",
        "category": "Sidestory"
      },
      {
        "command": "sidestory.reanchor",
        "title": "Re-anchor Section to Selection",
        "category": "Sidestory"
      },
      {
        "command": "sidestory.revokeWidgetConsent",
        "title": "Revoke Widget Consent",
        "category": "Sidestory"
      },
      {
        "command": "sidestory.enableWidgets",
        "title": "Enable Widgets",
        "category": "Sidestory"
      },
      {
        "command": "sidestory.checkWidgets",
        "title": "Check Widgets",
        "category": "Sidestory"
      },
      {
        "command": "sidestory.copyWidgetCheckCommand",
        "title": "Copy Widget Check Command",
        "category": "Sidestory"
      },
      {
        "command": "sidestory.addWidgetTypes",
        "title": "Add Widget Types",
        "category": "Sidestory"
      },
      {
        "command": "sidestory.goToStep",
        "title": "Go to Step…",
        "category": "Sidestory",
        "icon": "$(list-selection)"
      },
      {
        "command": "sidestory.showHere",
        "title": "Show Sidestories for This Code",
        "category": "Sidestory"
      },
      {
        "command": "sidestory.showSidestories",
        "title": "Show Sidestories",
        "category": "Sidestory"
      },
      {
        "command": "sidestory.copyAgentPrompt",
        "title": "Copy a Prompt for Your Agent",
        "category": "Sidestory"
      },
      {
        "command": "sidestory.openAt",
        "title": "Open Sidestory at a Step",
        "category": "Sidestory"
      },
      {
        "command": "sidestory.statusOpen",
        "title": "Open the Sidestory for This Line",
        "category": "Sidestory"
      },
      {
        "command": "sidestory.tree.open",
        "title": "Open",
        "category": "Sidestory"
      },
      {
        "command": "sidestory.openInNewPanel",
        "title": "Open in New Panel",
        "category": "Sidestory",
        "icon": "$(empty-window)"
      },
      {
        "command": "sidestory.tree.filter",
        "title": "Filter…",
        "category": "Sidestory",
        "icon": "$(filter)"
      },
      {
        "command": "sidestory.tree.clearFilter",
        "title": "Clear Filter",
        "category": "Sidestory",
        "icon": "$(clear-all)"
      },
      {
        "command": "sidestory.tree.refresh",
        "title": "Refresh",
        "category": "Sidestory",
        "icon": "$(refresh)"
      },
      {
        "command": "sidestory.tree.revealInExplorer",
        "title": "Reveal in Explorer",
        "category": "Sidestory"
      },
      {
        "command": "sidestory.tree.copyPath",
        "title": "Copy Path",
        "category": "Sidestory"
      },
      {
        "command": "sidestory.changes.nextFile",
        "title": "Next Changed File",
        "category": "Sidestory",
        "icon": "$(arrow-down)"
      },
      {
        "command": "sidestory.changes.prevFile",
        "title": "Previous Changed File",
        "category": "Sidestory",
        "icon": "$(arrow-up)"
      },
      {
        "command": "sidestory.changes.openChange",
        "title": "Open Change",
        "category": "Sidestory"
      },
      {
        "command": "sidestory.changes.nextUnexplained",
        "title": "Next Unexplained Change",
        "category": "Sidestory",
        "icon": "$(arrow-circle-down)"
      },
      {
        "command": "sidestory.changes.prevUnexplained",
        "title": "Previous Unexplained Change",
        "category": "Sidestory",
        "icon": "$(arrow-circle-up)"
      },
      {
        "command": "sidestory.changes.copyExplainPrompt",
        "title": "Copy Prompt: Explain This Branch",
        "category": "Sidestory",
        "icon": "$(sparkle)"
      },
      {
        "command": "sidestory.changes.dismissExplain",
        "title": "Don't Suggest on This Branch",
        "category": "Sidestory",
        "icon": "$(close)"
      },
      {
        "command": "sidestory.changes.copyUnsupported",
        "title": "Copy Unsupported Paths",
        "category": "Sidestory"
      },
      {
        "command": "sidestory.changes.copyUpdatePrompt",
        "title": "Copy Prompt: Update the Sidestory for New Changes",
        "category": "Sidestory",
        "icon": "$(sparkle)"
      },
      {
        "command": "sidestory.changes.copyChangePrompt",
        "title": "Copy Prompt: Explain This Change",
        "category": "Sidestory",
        "icon": "$(sparkle)"
      },
      {
        "command": "sidestory.changes.markTrivial",
        "title": "Mark as Trivial…",
        "category": "Sidestory",
        "icon": "$(dash)"
      },
      {
        "command": "sidestory.changes.repinStep",
        "title": "Re-pin This Step",
        "category": "Sidestory",
        "icon": "$(pin)"
      },
      {
        "command": "sidestory.changes.setBase",
        "title": "Set Base…",
        "category": "Sidestory",
        "icon": "$(git-compare)"
      },
      {
        "command": "sidestory.explainFile",
        "title": "Explain with Sidestory",
        "category": "Sidestory",
        "icon": "$(book)"
      }
    ],
    "keybindings": [
      {
        "command": "sidestory.nextStep",
        "key": "alt+]",
        "mac": "ctrl+alt+]",
        "when": "sidestory.active && !inlineSuggestionVisible && !suggestWidgetVisible"
      },
      {
        "command": "sidestory.prevStep",
        "key": "alt+[",
        "mac": "ctrl+alt+[",
        "when": "sidestory.active && !inlineSuggestionVisible && !suggestWidgetVisible"
      },
      {
        "command": "sidestory.changes.nextFile",
        "key": "ctrl+alt+pagedown",
        "mac": "ctrl+cmd+down",
        "when": "sidestory.changes.repo && (isInDiffEditor || sidestory.changes.activeFileChanged)"
      },
      {
        "command": "sidestory.changes.prevFile",
        "key": "ctrl+alt+pageup",
        "mac": "ctrl+cmd+up",
        "when": "sidestory.changes.repo && (isInDiffEditor || sidestory.changes.activeFileChanged)"
      },
      {
        "command": "sidestory.changes.nextUnexplained",
        "key": "ctrl+alt+shift+pagedown",
        "mac": "ctrl+cmd+shift+down",
        "when": "sidestory.changes.repo && (isInDiffEditor || sidestory.changes.activeFileChanged)"
      },
      {
        "command": "sidestory.changes.prevUnexplained",
        "key": "ctrl+alt+shift+pageup",
        "mac": "ctrl+cmd+shift+up",
        "when": "sidestory.changes.repo && (isInDiffEditor || sidestory.changes.activeFileChanged)"
      }
    ],
    "configuration": {
      "title": "Sidestory",
      "properties": {
        "sidestory.followCursorInDiagrams": {
          "type": "boolean",
          "default": true,
          "description": "Ring the boxes and links in a sidestory (data-explain-ref, data-explain-code) whose code holds the editor cursor. Steps change only for code a section covers."
        },
        "sidestory.dimUnfocused": {
          "type": "boolean",
          "default": true,
          "description": "Dim code outside the active step when you move through a sidestory."
        },
        "sidestory.widgets.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "markdownDescription": "Run interactive widgets in sidestories. Widgets are code from the repository: they never run in Restricted Mode, and each workspace asks before running them. A repository's own settings can't turn this on."
        },
        "sidestory.codeLens.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "language-overridable",
          "markdownDescription": "Show a CodeLens above code that a sidestory explains (at most 30 per file; hidden while that sidestory is open in a panel)."
        },
        "sidestory.gutter.enabled": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Mark the first line of code a sidestory explains with a book in the gutter, and in the overview ruler."
        },
        "sidestory.statusBar.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show in the status bar which sidestory explains the cursor's line, when no open panel shows it."
        },
        "sidestory.sidebar.followPanel": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Select the sidestory a panel shows in the Sidestories view."
        },
        "sidestory.changes.defaultBase": {
          "type": "string",
          "default": "",
          "markdownDescription": "The branch, tag or commit to compare branches with (for example `develop` or `origin/main`). The base is, in order: the one picked with **Sidestory: Set Base…** for the branch; the `base` of a sidestory added on the branch; the branch base the Git extension recorded (`branch.<name>.vscode-merge-base`); this setting; the remote's default branch; then `main` or `master`."
        },
        "sidestory.changes.includeUncommitted": {
          "type": "boolean",
          "default": true,
          "description": "Compare the working tree (with staged, unstaged and untracked changes) rather than the last commit, for coverage, its decorations and the diffs steps open."
        },
        "sidestory.changes.openStepsIn": {
          "type": "string",
          "enum": [
            "diff",
            "editor"
          ],
          "enumDescriptions": [
            "Steps of a sidestory with a base open the branch’s merge diff, at the step’s side.",
            "Steps open plain editors (removed code in a read-only view of the old file)."
          ],
          "default": "diff",
          "description": "Where the steps of a sidestory that explains a branch (one with a \"base\") open."
        },
        "sidestory.changes.suggestExplain": {
          "type": "boolean",
          "default": true,
          "description": "Offer \"Copy Prompt: Explain This Branch\" under \"This branch\" in the Sidestories view when the branch has changes and no sidestory explains it yet."
        },
        "sidestory.changes.markUnexplained": {
          "type": "boolean",
          "default": false,
          "description": "Mark unexplained changes in the gutter of the branch’s diffs, also when no sidestory with this base is open."
        }
      }
    },
    "colors": [
      {
        "id": "sidestory.focusBackground",
        "description": "Background of the lines the active sidestory step is about.",
        "defaults": {
          "dark": "editor.rangeHighlightBackground",
          "light": "editor.rangeHighlightBackground",
          "highContrast": "#00000000",
          "highContrastLight": "#00000000"
        }
      },
      {
        "id": "sidestory.focusBorder",
        "description": "Left bar on the active step's lines when the step has no accent color.",
        "defaults": {
          "dark": "focusBorder",
          "light": "focusBorder",
          "highContrast": "contrastActiveBorder",
          "highContrastLight": "contrastActiveBorder"
        }
      },
      {
        "id": "sidestory.highlightBackground",
        "description": "Background of identifiers the active step highlights.",
        "defaults": {
          "dark": "editor.wordHighlightStrongBackground",
          "light": "editor.wordHighlightStrongBackground",
          "highContrast": "#00000000",
          "highContrastLight": "#00000000"
        }
      },
      {
        "id": "sidestory.highlightBorder",
        "description": "Border of identifiers the active step highlights.",
        "defaults": {
          "dark": "#00000000",
          "light": "#00000000",
          "highContrast": "contrastActiveBorder",
          "highContrastLight": "contrastActiveBorder"
        }
      },
      {
        "id": "sidestory.widgetHighlightBackground",
        "description": "Background of the lines a widget highlights in the editor.",
        "defaults": {
          "dark": "editor.wordHighlightBackground",
          "light": "editor.wordHighlightBackground",
          "highContrast": "#00000000",
          "highContrastLight": "#00000000"
        }
      },
      {
        "id": "sidestory.widgetHighlightBorder",
        "description": "Border of the lines a widget highlights in the editor (high contrast themes, where backgrounds are transparent).",
        "defaults": {
          "dark": "editor.wordHighlightBorder",
          "light": "editor.wordHighlightBorder",
          "highContrast": "contrastActiveBorder",
          "highContrastLight": "contrastActiveBorder"
        }
      },
      {
        "id": "sidestory.staleForeground",
        "description": "Sidestory sections whose code changed a lot.",
        "defaults": {
          "dark": "editorWarning.foreground",
          "light": "#8a6100",
          "highContrast": "editorWarning.foreground",
          "highContrastLight": "editorWarning.foreground"
        }
      },
      {
        "id": "sidestory.lostForeground",
        "description": "Sidestory sections whose code can't be found.",
        "defaults": {
          "dark": "editorError.foreground",
          "light": "editorError.foreground",
          "highContrast": "editorError.foreground",
          "highContrastLight": "editorError.foreground"
        }
      },
      {
        "id": "sidestory.explainedRuler",
        "description": "Overview ruler mark for code a sidestory explains (with sidestory.gutter.enabled).",
        "defaults": {
          "dark": "editorInfo.foreground",
          "light": "editorInfo.foreground",
          "highContrast": "contrastActiveBorder",
          "highContrastLight": "contrastActiveBorder"
        }
      },
      {
        "id": "sidestory.unexplainedBorder",
        "description": "Gutter and overview ruler mark for changed lines no step explains yet (in the branch’s diffs).",
        "defaults": {
          "dark": "#CCA70099",
          "light": "#BF880099",
          "highContrast": "editorWarning.foreground",
          "highContrastLight": "editorWarning.foreground"
        }
      },
      {
        "id": "sidestory.unexplainedForeground",
        "description": "Icon color of partly explained changes in the This File view.",
        "defaults": {
          "dark": "editorWarning.foreground",
          "light": "editorWarning.foreground",
          "highContrast": "editorWarning.foreground",
          "highContrastLight": "editorWarning.foreground"
        }
      },
      {
        "id": "sidestory.coverageDoneForeground",
        "description": "Badge color of changed files whose changes are all explained or marked trivial (Explorer, Source Control, Git Tree Compare).",
        "defaults": {
          "dark": "charts.green",
          "light": "charts.green",
          "highContrast": "charts.green",
          "highContrastLight": "charts.green"
        }
      },
      {
        "id": "sidestory.coverageLeftForeground",
        "description": "Badge color of changed files with changes no step explains yet, or whose step needs a look (Explorer, Source Control, Git Tree Compare).",
        "defaults": {
          "dark": "editorWarning.foreground",
          "light": "editorWarning.foreground",
          "highContrast": "editorWarning.foreground",
          "highContrastLight": "editorWarning.foreground"
        }
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "sidestory.nextStep",
          "when": "sidestory.active"
        },
        {
          "command": "sidestory.prevStep",
          "when": "sidestory.active"
        },
        {
          "command": "sidestory.tree.open",
          "when": "false"
        },
        {
          "command": "sidestory.openAt",
          "when": "false"
        },
        {
          "command": "sidestory.statusOpen",
          "when": "false"
        },
        {
          "command": "sidestory.openInNewPanel",
          "when": "false"
        },
        {
          "command": "sidestory.showHere",
          "when": "editorIsOpen"
        },
        {
          "command": "sidestory.tree.filter",
          "when": "false"
        },
        {
          "command": "sidestory.tree.clearFilter",
          "when": "false"
        },
        {
          "command": "sidestory.tree.refresh",
          "when": "false"
        },
        {
          "command": "sidestory.tree.revealInExplorer",
          "when": "false"
        },
        {
          "command": "sidestory.tree.copyPath",
          "when": "false"
        },
        {
          "command": "sidestory.checkWidgets",
          "when": "isWorkspaceTrusted"
        },
        {
          "command": "sidestory.copyWidgetCheckCommand",
          "when": "isWorkspaceTrusted"
        },
        {
          "command": "sidestory.changes.nextFile",
          "when": "sidestory.changes.repo"
        },
        {
          "command": "sidestory.changes.prevFile",
          "when": "sidestory.changes.repo"
        },
        {
          "command": "sidestory.changes.nextUnexplained",
          "when": "sidestory.changes.layer"
        },
        {
          "command": "sidestory.changes.prevUnexplained",
          "when": "sidestory.changes.layer"
        },
        {
          "command": "sidestory.changes.openChange",
          "when": "false"
        },
        {
          "command": "sidestory.changes.copyExplainPrompt",
          "when": "sidestory.changes.repo && !sidestory.changes.layer"
        },
        {
          "command": "sidestory.changes.dismissExplain",
          "when": "false"
        },
        {
          "command": "sidestory.changes.copyUnsupported",
          "when": "false"
        },
        {
          "command": "sidestory.changes.copyUpdatePrompt",
          "when": "sidestory.changes.layer"
        },
        {
          "command": "sidestory.changes.copyChangePrompt",
          "when": "sidestory.changes.activeFileChanged"
        },
        {
          "command": "sidestory.changes.markTrivial",
          "when": "sidestory.changes.activeFileChanged && !sidestory.readOnly"
        },
        {
          "command": "sidestory.changes.repinStep",
          "when": "sidestory.changes.activeFileChanged && sidestory.changes.layer && !sidestory.readOnly"
        },
        {
          "command": "sidestory.changes.setBase",
          "when": "sidestory.changes.repo"
        }
      ],
      "editor/context": [
        {
          "command": "sidestory.changes.copyChangePrompt",
          "when": "sidestory.changes.activeFileChanged && (resourceScheme == file || resourceScheme == sidestory-git)",
          "group": "sidestory@1"
        },
        {
          "command": "sidestory.changes.markTrivial",
          "when": "sidestory.changes.activeFileChanged && !sidestory.readOnly && (resourceScheme == file || resourceScheme == sidestory-git)",
          "group": "sidestory@2"
        },
        {
          "command": "sidestory.changes.repinStep",
          "when": "sidestory.changes.activeFileChanged && sidestory.changes.layer && !sidestory.readOnly && (resourceScheme == file || resourceScheme == sidestory-git)",
          "group": "sidestory@3"
        },
        {
          "command": "sidestory.reanchor",
          "when": "sidestory.active && editorHasSelection",
          "group": "navigation@90"
        },
        {
          "command": "sidestory.showHere",
          "when": "sidestory.coveredHere",
          "group": "navigation@91"
        },
        {
          "command": "sidestory.explainFile",
          "when": "sidestory.available && resourceScheme == file",
          "group": "sidestory@4"
        }
      ],
      "explorer/context": [
        {
          "command": "sidestory.open",
          "when": "explorerResourceIsFolder && resourceDirname =~ /\\.sidestory$/",
          "group": "navigation@90"
        },
        {
          "command": "sidestory.explainFile",
          "when": "sidestory.available && !explorerResourceIsFolder",
          "group": "sidestory@2"
        }
      ],
      "view/title": [
        {
          "command": "sidestory.goToStep",
          "when": "view == sidestory.tree",
          "group": "navigation@1"
        },
        {
          "command": "sidestory.tree.filter",
          "when": "view == sidestory.tree",
          "group": "navigation@2"
        },
        {
          "command": "sidestory.tree.clearFilter",
          "when": "view == sidestory.tree && sidestory.treeFiltered",
          "group": "navigation@3"
        },
        {
          "command": "sidestory.tree.refresh",
          "when": "view == sidestory.tree",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "sidestory.openInNewPanel",
          "when": "view == sidestory.tree && viewItem =~ /^(top|detail|broken)$/",
          "group": "inline"
        },
        {
          "command": "sidestory.tree.open",
          "when": "view == sidestory.tree && viewItem =~ /^(top|detail|broken)$/",
          "group": "1_open@1"
        },
        {
          "command": "sidestory.openInNewPanel",
          "when": "view == sidestory.tree && viewItem =~ /^(top|detail|broken)$/",
          "group": "1_open@2"
        },
        {
          "command": "sidestory.goToStep",
          "when": "view == sidestory.tree && viewItem =~ /^(top|detail|broken)$/",
          "group": "2_steps@1"
        },
        {
          "command": "sidestory.pin",
          "when": "view == sidestory.tree && viewItem =~ /^(top|detail|broken)$/",
          "group": "3_edit@1"
        },
        {
          "command": "sidestory.checkWidgets",
          "when": "view == sidestory.tree && viewItem =~ /^(top|detail|broken)$/ && isWorkspaceTrusted",
          "group": "3_edit@2"
        },
        {
          "command": "sidestory.copyWidgetCheckCommand",
          "when": "view == sidestory.tree && viewItem =~ /^(top|detail|broken)$/ && isWorkspaceTrusted",
          "group": "3_edit@3"
        },
        {
          "command": "sidestory.tree.revealInExplorer",
          "when": "view == sidestory.tree && viewItem =~ /^(top|detail|broken)$/",
          "group": "4_path@1"
        },
        {
          "command": "sidestory.tree.copyPath",
          "when": "view == sidestory.tree && viewItem =~ /^(top|detail|broken)$/",
          "group": "4_path@2"
        },
        {
          "command": "sidestory.changes.dismissExplain",
          "when": "view == sidestory.tree && viewItem == explainPrompt",
          "group": "inline@1"
        },
        {
          "command": "sidestory.changes.copyChangePrompt",
          "when": "view == sidestory.thisFile && viewItem =~ /^thisFileChange:(unexplained|partly|needsLook|whole)/",
          "group": "inline@1"
        },
        {
          "command": "sidestory.changes.copyChangePrompt",
          "when": "view == sidestory.thisFile && viewItem =~ /^thisFileChange:(unexplained|partly|needsLook|whole)/",
          "group": "1_explain@1"
        },
        {
          "command": "sidestory.changes.markTrivial",
          "when": "view == sidestory.thisFile && viewItem =~ /^thisFileChange:(unexplained|partly|needsLook)/ && !sidestory.readOnly",
          "group": "1_explain@2"
        },
        {
          "command": "sidestory.changes.repinStep",
          "when": "view == sidestory.thisFile && (viewItem == thisFileStep:needsLook || viewItem == thisFileChange:needsLook) && !sidestory.readOnly",
          "group": "inline@2"
        },
        {
          "command": "sidestory.changes.repinStep",
          "when": "view == sidestory.thisFile && (viewItem == thisFileStep:needsLook || viewItem == thisFileChange:needsLook) && !sidestory.readOnly",
          "group": "1_explain@3"
        },
        {
          "command": "sidestory.changes.nextUnexplained",
          "when": "view == sidestory.tree && (viewItem == branchSidestory || viewItem == updatePrompt)",
          "group": "inline@1"
        },
        {
          "command": "sidestory.changes.setBase",
          "when": "view == sidestory.tree && viewItem == branch",
          "group": "inline@1"
        }
      ],
      "editor/title/context": [
        {
          "command": "sidestory.explainFile",
          "when": "sidestory.available && resourceScheme == file",
          "group": "sidestory@1"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sidestory",
          "title": "Sidestory",
          "icon": "media/sidestory.svg"
        }
      ]
    },
    "views": {
      "sidestory": [
        {
          "id": "sidestory.tree",
          "name": "Sidestories",
          "when": "sidestory.available",
          "icon": "media/sidestory.svg",
          "contextualTitle": "Sidestory"
        },
        {
          "id": "sidestory.thisFile",
          "name": "This File",
          "when": "sidestory.available",
          "icon": "media/sidestory.svg",
          "contextualTitle": "Sidestory",
          "visibility": "collapsed"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "sidestory.tree",
        "when": "workbenchState == empty",
        "contents": "Open a folder to see its sidestories.\n[Open Folder](command:workbench.action.files.openFolder)"
      },
      {
        "view": "sidestory.tree",
        "when": "workbenchState != empty && sidestory.indexState == empty",
        "contents": "No sidestories in this workspace yet. A sidestory is a folder in .sidestory/ with a page and a manifest.json, shown beside the code and linked to it.\n[Read the Guide](https://github.com/mozru/sidestory/blob/main/docs/GUIDE.md)\n[Copy a Prompt for Your Agent](command:sidestory.copyAgentPrompt)\nOr, in Claude Code, run /plugin install sidestory@sidestory, then ask: \"Explain how … works, with Sidestory.\""
      },
      {
        "view": "sidestory.tree",
        "when": "workbenchState != empty && sidestory.indexState != empty && sidestory.indexState != ready",
        "contents": "Looking for sidestories…"
      },
      {
        "view": "sidestory.thisFile",
        "when": "sidestory.thisFile.state == empty",
        "contents": "No sidestory explains this file yet.\n[Copy Prompt: Explain This File](command:sidestory.explainFile)"
      },
      {
        "view": "sidestory.thisFile",
        "when": "sidestory.thisFile.state == noFile",
        "contents": "Open a file to see the steps that explain it."
      }
    ]
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p src/core/tsconfig.json --noEmit && tsc -p src/widget-runtime/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:webview": "playwright test -c test/webview/playwright.config.ts",
    "test:widgets": "playwright test -c test/widgets/playwright.config.ts",
    "test:e2e": "playwright test -c test/e2e/playwright.config.ts",
    "pin": "node scripts/pin.ts",
    "release": "node scripts/release.mjs",
    "sync-skill": "node scripts/sync-skill.mjs",
    "package": "node scripts/build.mjs --production && vsce package --no-dependencies -o dist/sidestory.vsix",
    "check": "npm run typecheck && npm test && npm run build",
    "test:desktop": "npm run build && node test/desktop/run.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
