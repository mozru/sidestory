    "@types/react-dom": "19.3.0",
    "@types/vscode": "1.95.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "^4.0.0",
    "clsx": "2.1.1",
    "d3": "7.9.0",
    "esbuild": "^0.28.2",
    "lodash": "4.18.1",
    "lucide-react": "1.52.0",
    "mocha": "11.7.5",
    "motion": "14.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-is": "19.3.0",
    "recharts": "3.10.1",
    "tailwind-merge": "3.7.0",
