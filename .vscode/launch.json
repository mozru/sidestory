{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Code Explainer (sample workspace)",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}", "${workspaceFolder}/fixtures/sample-workspace"],
      "outFiles": ["${workspaceFolder}/dist/**/*.cjs", "${workspaceFolder}/dist/**/*.js"],
      "preLaunchTask": "build"
    }
  ]
}
